{
  "name": "dastiar",
  "version": "1.0.0",
  "private": true,
  "description": "دستیار هوش مصنوعی شخصی — Local-First با حافظه دائمی، صوت فارسی و پل ماینکرفت",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3784",
    "build": "next build",
    "start": "next start -p 3784",
    "db:sync": "tsx scripts/sync-db.ts",
    "lint": "next lint",
    "electron": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "mineflayer": "^4.24.0",
    "mineflayer-collectblock": "^1.4.1",
    "mineflayer-pathfinder": "^2.4.5",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ir.dastiar.app",
    "productName": "Dastiar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "release/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "دستیار",
      "artifactName": "Dastiar Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Dastiar Portable ${version}.${ext}"
    }
  }
}
